# Hedwig — copy to .env and fill in. Generate secrets with: openssl rand -hex 32
APP_URL=https://hedwig.example.com
SESSION_SECRET=
DB_PASSWORD=
ENCRYPTION_KEY=
APP_PORT=443
APP_HTTP_PORT=80

# Model gateway (OpenAI-compatible). Leave HEDWIG_LLM_BASE_URL empty to run without models.
HEDWIG_LLM_BASE_URL=http://llm-proxy.cls/v1
HEDWIG_LLM_CATALOG_URL=http://llm-proxy.cls/catalog.json
HEDWIG_LLM_MODELS_FAST=Qwen/Qwen3.8-Flash-Next
HEDWIG_LLM_MODELS_LONG=Qwen/Qwen3.8-Flash-Next
HEDWIG_LLM_MODELS_AGENT=Qwen/Qwen3.8-Flash-Next
# Optional: used when the primary model does not answer within HEDWIG_LLM_FALLBACK_AFTER_MS or errors.
HEDWIG_LLM_FALLBACK_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
HEDWIG_LLM_FALLBACK_AFTER_MS=45000

# Embeddings: openai (any /v1/embeddings server; the bundled `embed` service by default), hash, or off.
HEDWIG_EMBEDDINGS_PROVIDER=openai
HEDWIG_EMBEDDINGS_BASE_URL=http://llm-proxy.cls/v1
HEDWIG_EMBEDDINGS_MODEL=bge-m3
HEDWIG_EMBEDDINGS_DIMS=1024

# Default timezone for briefings and automations (users can change their own).
HEDWIG_INSIGHTS_TIMEZONE=UTC
TZ=UTC
